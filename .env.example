# DisasterAssist AI - example settings.
# Copy this file to a new file named .env and fill in your own values there.
# NEVER put real keys in this example file, and never share your .env file.


LLM_PROVIDER=navigatelabs

GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.5-flash-lite



# Limits for the AI call. Leave empty to use the defaults (60 seconds, 2000 tokens).
LLM_MAX_OUTPUT_TOKENS=
LLM_TIMEOUT_SECONDS=

NAVIGATE_API_KEY=
NAVIGATE_BASE_URL=https://nexusapi.navigatelabs.ai

NAVIGATE_MODEL=nova-micro

